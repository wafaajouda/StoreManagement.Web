@model List<Brand>

<a class="btn btn-success" asp-controller="Brand" asp-action="Create">Add Brand</a>
<br />

@if(Model.Any())
{
    <br />
    <form asp-controller="Brand" asp-action="Index">
        <div class="row">
            <div class="col-md-4">
                <input name="searchKey" value="@ViewBag.searchKey" class="form-control" placeholder="Search..." />
            </div>
            <div class="col-md-2">
                <input type="submit" class="btn btn-primary" value="Search" />
            </div>
        </div>
    </form>


    <table class="table table-hover">
        <tr>
            <th>Brand Id</th>
            <th>Brand Name</th>
            <th>Actions</th>
        </tr>

        @foreach(var brand in Model)
        {
            <tr>
                <th>@brand.Id</th>
                <th>@brand.Name</th>
                <th>
                    <a class = "btn btn-warning" href="~/Brand/Update/@brand.Id">Update</a>
                    <a class = "btn btn-danger" href="~/Brand/Delete/@brand.Id">Delete</a>
                </th>
            </tr>
        }
    </table>
    
}
else
{
    <br />
    <div class="alert alert-warning">
        No Brands Found.
    </div>
}