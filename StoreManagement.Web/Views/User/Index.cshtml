@model List<UserViewModel>

<h1>System Users</h1>
<hr />

<a class="btn btn-success" href="~/User/Create">Add User</a>
<br />

@if (Model.Any())
{
    <table class="table table-hover">
        <tr>
            <th>User Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Created Date</th>
            <th>Operation</th>
        </tr>

        @foreach (var user in Model)
        {
            <tr>
                <th>@user.UserName</th>
                <th>@user.Email</th>
                <th>@user.PhoneNumber</th>
                <th>@user.CreatedAt.ToString("yyyy/MM/dd")</th>
                <th>
                    <a class="btn btn-danger" href="~/user/delete/@user.Id">Delete</a>
                </th>
            </tr>
        }
    </table>
}
else
{
    <br />
    <div class="alert alert-warning">
        No Users
    </div>
}